APP_NAME=Math Tutor
DATABASE_URL=sqlite+pysqlite:///:memory:

# Durable session store. If set to a file path, sessions persist to SQLite
# (stdlib sqlite3) and survive restarts. Leave unset for an in-memory store.
# SESSION_DB_PATH=./sessions.db

# Per-minute request cap for /session/start (per student) and /turn (per
# session). Unset disables rate limiting. Per-process, in-memory.
# RATE_LIMIT_PER_MINUTE=60

# Daily per-student LLM call budget (rolling 24h). When exceeded, turns degrade
# to deterministic narration instead of calling the provider; grading and
# scheduling are unaffected. Unset disables the cap.
# DAILY_LLM_BUDGET=200

# Runtime provider: mock, gemini, or anthropic.
LLM_PROVIDER=mock
LLM_ROUTING_MODE=strong_only
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=15

# Gemini API runtime settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_ROUTINE_MODEL=
GEMINI_HARD_MODEL=
GEMINI_TOP_MODEL=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# Anthropic API runtime settings.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_ROUTINE_MODEL=
ANTHROPIC_HARD_MODEL=
ANTHROPIC_TOP_MODEL=
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_VERSION=2023-06-01
